{% extends 'layouts/front.twig' %}

{% block content %}
<!-- Hero -->
<div class="bg-body-extra-light overflow-hidden">
    <div class="hero">
        <div class="hero-inner">
            <div class="content content-full text-center">
                <h1 class="display-3 fw-bold mb-2">
                    Bienvenue sur {{ siteName | default('Mon Site') }}
                </h1>
                <h2 class="fw-medium text-muted mb-5">
                    {{ siteTagline | default('Votre blog moderne et elegant') }}
                </h2>
                <a class="btn btn-lg btn-primary fw-semibold me-1 mb-2" href="/blog">
                    <i class="fa fa-newspaper opacity-50 me-1"></i> Lire le blog
                </a>
                <a class="btn btn-lg btn-alt-primary fw-semibold mb-2" href="/about">
                    <i class="fa fa-info-circle opacity-50 me-1"></i> En savoir plus
                </a>
            </div>
        </div>
    </div>
</div>
<!-- END Hero -->

<!-- Features -->
<div class="bg-body-light">
    <div class="content content-full">
        <div class="py-5">
            <div class="row text-center">
                <div class="col-md-4 py-3">
                    <div class="mb-3">
                        <i class="fa fa-pencil-alt fa-3x text-primary"></i>
                    </div>
                    <h3 class="h4 fw-bold">Articles de qualite</h3>
                    <p class="text-muted mb-0">
                        Des articles soigneusement rediges pour vous apporter les meilleures informations.
                    </p>
                </div>
                <div class="col-md-4 py-3">
                    <div class="mb-3">
                        <i class="fa fa-comments fa-3x text-primary"></i>
                    </div>
                    <h3 class="h4 fw-bold">Communaute active</h3>
                    <p class="text-muted mb-0">
                        Echangez avec notre communaute passionnee et partagez vos idees.
                    </p>
                </div>
                <div class="col-md-4 py-3">
                    <div class="mb-3">
                        <i class="fa fa-bell fa-3x text-primary"></i>
                    </div>
                    <h3 class="h4 fw-bold">Restez informe</h3>
                    <p class="text-muted mb-0">
                        Abonnez-vous a notre newsletter pour ne rien manquer.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END Features -->

<!-- Recent Posts -->
<div class="bg-body-extra-light">
    <div class="content content-full">
        <div class="py-5">
            <h2 class="fw-bold text-center mb-5">
                <i class="fa fa-fire text-primary me-2"></i> Articles recents
            </h2>
            <div class="row">
                {% for post in recentPosts %}
                <div class="col-md-6 col-lg-4 py-3">
                    <div class="block block-rounded h-100 mb-0">
                        {% if post.image %}
                        <div class="block-content p-0 overflow-hidden">
                            <a class="img-link img-link-zoom-in" href="/blog/{{ post.slug }}">
                                <img class="img-fluid" src="{{ post.image }}" alt="{{ post.title }}">
                            </a>
                        </div>
                        {% endif %}
                        <div class="block-content">
                            <h4 class="mb-2">
                                <a class="text-dark" href="/blog/{{ post.slug }}">{{ post.title }}</a>
                            </h4>
                            <p class="fs-sm text-muted">
                                <i class="fa fa-calendar-alt me-1"></i> {{ post.createdAt | date('d/m/Y') }}
                                {% if post.category %}
                                <span class="mx-1">|</span>
                                <i class="fa fa-folder me-1"></i> {{ post.category }}
                                {% endif %}
                            </p>
                            <p class="text-muted">
                                {{ post.excerpt | default(post.content | slice(0, 150)) }}...
                            </p>
                            <a class="btn btn-sm btn-alt-primary" href="/blog/{{ post.slug }}">
                                Lire la suite <i class="fa fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="col-12 text-center py-5">
                    <p class="text-muted mb-0">Aucun article pour le moment.</p>
                </div>
                {% endfor %}
            </div>
            {% if recentPosts | length > 0 %}
            <div class="text-center mt-4">
                <a class="btn btn-primary" href="/blog">
                    <i class="fa fa-book-open me-1"></i> Voir tous les articles
                </a>
            </div>
            {% endif %}
        </div>
    </div>
</div>
<!-- END Recent Posts -->

<!-- Categories -->
{% if categories | length > 0 %}
<div class="bg-body-light">
    <div class="content content-full">
        <div class="py-5">
            <h2 class="fw-bold text-center mb-5">
                <i class="fa fa-folder text-primary me-2"></i> Categories
            </h2>
            <div class="row justify-content-center">
                {% for category in categories %}
                <div class="col-6 col-md-4 col-lg-3 col-xl-2 py-2">
                    <a class="block block-rounded block-link-shadow text-center h-100 mb-0" href="/blog/category/{{ category.slug }}">
                        <div class="block-content">
                            <div class="fs-2 fw-semibold text-primary">{{ category.postsCount | default(0) }}</div>
                            <div class="fs-sm fw-semibold text-uppercase text-muted">{{ category.name }}</div>
                        </div>
                    </a>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endif %}
<!-- END Categories -->

<!-- Call to Action -->
<div class="bg-primary">
    <div class="content content-full">
        <div class="py-5 text-center">
            <h2 class="fw-bold text-white mb-2">Pret a nous rejoindre ?</h2>
            <p class="fs-lg text-white-75 mb-4">
                Creez votre compte gratuitement et rejoignez notre communaute.
            </p>
            {% if user %}
            <a class="btn btn-lg btn-light fw-semibold" href="/profile">
                <i class="fa fa-user me-1"></i> Mon profil
            </a>
            {% else %}
            <a class="btn btn-lg btn-light fw-semibold me-1 mb-2" href="/register">
                <i class="fa fa-user-plus me-1"></i> Creer un compte
            </a>
            <a class="btn btn-lg btn-outline-light fw-semibold mb-2" href="/login">
                <i class="fa fa-sign-in-alt me-1"></i> Se connecter
            </a>
            {% endif %}
        </div>
    </div>
</div>
<!-- END Call to Action -->
{% endblock %}
