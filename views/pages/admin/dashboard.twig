{% extends 'layouts/admin.twig' %}

{% block content %}
<div class="content">
    <h2 class="content-heading">
        <i class="fa fa-tachometer-alt me-2"></i> Dashboard
        <small class="d-block d-sm-inline-block mt-2 mt-sm-0 fs-sm fw-normal text-muted">Bienvenue sur votre tableau de bord</small>
    </h2>

    <!-- Statistics -->
    <div class="row">
        <div class="col-6 col-md-3 col-lg-6 col-xl-3">
            <a class="block block-rounded block-link-pop" href="/admin/posts">
                <div class="block-content block-content-full">
                    <div class="fs-sm fw-semibold text-uppercase text-muted">Articles</div>
                    <div class="fs-2 fw-bold text-dark">{{ stats.posts | default(0) }}</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-6 col-xl-3">
            <a class="block block-rounded block-link-pop" href="/admin/comments">
                <div class="block-content block-content-full">
                    <div class="fs-sm fw-semibold text-uppercase text-muted">Commentaires</div>
                    <div class="fs-2 fw-bold text-dark">{{ stats.comments | default(0) }}</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-6 col-xl-3">
            <a class="block block-rounded block-link-pop" href="/admin/users">
                <div class="block-content block-content-full">
                    <div class="fs-sm fw-semibold text-uppercase text-muted">Utilisateurs</div>
                    <div class="fs-2 fw-bold text-dark">{{ stats.users | default(0) }}</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3 col-lg-6 col-xl-3">
            <a class="block block-rounded block-link-pop" href="/admin/categories">
                <div class="block-content block-content-full">
                    <div class="fs-sm fw-semibold text-uppercase text-muted">Categories</div>
                    <div class="fs-2 fw-bold text-dark">{{ stats.categories | default(0) }}</div>
                </div>
            </a>
        </div>
    </div>
    <!-- END Statistics -->

    <div class="row">
        <!-- Recent Posts -->
        <div class="col-lg-6">
            <div class="block block-rounded">
                <div class="block-header block-header-default">
                    <h3 class="block-title">
                        <i class="fa fa-file-alt text-muted me-1"></i> Articles recents
                    </h3>
                    <div class="block-options">
                        <a class="btn btn-sm btn-alt-primary" href="/admin/posts/create">
                            <i class="fa fa-plus me-1"></i> Nouveau
                        </a>
                    </div>
                </div>
                <div class="block-content">
                    <table class="table table-striped table-hover table-vcenter">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th class="d-none d-sm-table-cell" style="width: 120px;">Date</th>
                                <th class="text-center" style="width: 80px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for post in recentPosts %}
                            <tr>
                                <td class="fw-semibold">
                                    <a href="/admin/posts/{{ post.id }}">{{ post.title }}</a>
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    <span class="fs-sm text-muted">{{ post.createdAt | date('d/m/Y') }}</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a class="btn btn-alt-secondary" href="/admin/posts/{{ post.id }}/edit">
                                            <i class="fa fa-pencil-alt"></i>
                                        </a>
                                        <a class="btn btn-alt-secondary" href="/blog/{{ post.slug }}" target="_blank">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-muted">Aucun article</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- END Recent Posts -->

        <!-- Recent Comments -->
        <div class="col-lg-6">
            <div class="block block-rounded">
                <div class="block-header block-header-default">
                    <h3 class="block-title">
                        <i class="fa fa-comments text-muted me-1"></i> Commentaires recents
                    </h3>
                    <div class="block-options">
                        <a class="btn btn-sm btn-alt-primary" href="/admin/comments">
                            Voir tout
                        </a>
                    </div>
                </div>
                <div class="block-content">
                    <ul class="list-group push">
                        {% for comment in recentComments %}
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">{{ comment.author.name }}</span>
                                    <span class="text-muted">sur</span>
                                    <a href="/admin/posts/{{ comment.post.id }}">{{ comment.post.title }}</a>
                                </div>
                                <span class="fs-sm text-muted">{{ comment.createdAt | date('d/m/Y') }}</span>
                            </div>
                            <p class="fs-sm text-muted mb-0 mt-1">{{ comment.content | slice(0, 100) }}...</p>
                        </li>
                        {% else %}
                        <li class="list-group-item text-center text-muted">Aucun commentaire</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        <!-- END Recent Comments -->
    </div>

    <!-- Quick Actions -->
    <div class="block block-rounded">
        <div class="block-header block-header-default">
            <h3 class="block-title">Actions rapides</h3>
        </div>
        <div class="block-content">
            <div class="row text-center">
                <div class="col-6 col-md-3 py-3 d-flex align-items-center">
                    <a class="btn btn-alt-primary w-100 py-2 d-flex justify-content-between align-items-center" href="/admin/posts/create">
                        <div class="d-block">Nouvel article</div>
                        <i class="fa fa-plus fa-2x"></i>
                    </a>
                </div>
                <div class="col-6 col-md-3 py-3 d-flex align-items-center">
                    <a class="btn btn-alt-info w-100 py-2 d-flex justify-content-between align-items-center" href="/admin/categories/create">
                        <div class="d-block0">Nouvelle catégorie</div>
                        <i class="fa fa-folder-plus fa-2x"></i>
                    </a>
                </div>
                <div class="col-6 col-md-3 py-3 d-flex align-items-center">
                    <a class="btn btn-alt-success w-100 py-2 d-flex justify-content-between align-items-center" href="/admin/users/create">
                        <div class="d-block">Nouvel utilisateur</div>
                        <i class="fa fa-user-plus fa-2x"></i>
                    </a>
                </div>
                <div class="col-6 col-md-3 py-3 d-flex align-items-center">
                    <a class="btn btn-alt-warning w-100 py-2 d-flex justify-content-between align-items-center" href="/admin/settings">
                        <div class="d-block">Paramètres</div>
                        <i class="fa fa-cog fa-2x"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- END Quick Actions -->
</div>
{% endblock %}
