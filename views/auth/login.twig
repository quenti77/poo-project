{% extends 'layouts/front.twig' %}

{% block content %}

    <div class="bg-body-dark">
        <div class="hero-static content content-full px-1">
            <div class="row mx-0 justify-content-center">
                <div class="col-lg-8 col-xl-6">
                    <div class="py-4 text-center">
                        <h1 class="h3 fw-bold mt-4 mb-1">
                            {{ 'auth.login.title' | trans }}
                        </h1>
                    </div>
                    <form class="js-validation-signin" action="{{ transPath('auth.login') }}" method="POST" novalidate="novalidate">
                        <div class="block block-themed block-rounded block-fx-shadow">
                            <div class="block-header bg-gd-dusk">
                                <h3 class="block-title">{{ 'auth.login.card.title' | trans }}</h3>
                            </div>
                            <div class="block-content">
                                <div class="form-floating mb-4">
                                    <input type="text" class="form-control" id="login-username" name="login-username" placeholder="{{ 'auth.login.card.username.placeholder' | trans }}">
                                    <label class="form-label" for="login-username">
                                        {{ 'auth.login.card.username.label' | trans }}
                                    </label>
                                </div>
                                <div class="form-floating mb-4">
                                    <input type="password" class="form-control" id="login-password" name="login-password" placeholder="{{ 'auth.login.card.password.placeholder' | trans }}">
                                    <label class="form-label" for="login-password">
                                        {{ 'auth.login.card.password.label' | trans }}
                                    </label>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6 d-sm-flex align-items-center push">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="login-remember-me" name="login-remember-me">
                                            <label class="form-check-label" for="login-remember-me">
                                                {{ 'auth.login.card.remember-me' | trans }}
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 text-sm-end push">
                                        <button type="submit" class="btn btn-lg btn-alt-primary fw-medium">
                                            {{ 'auth.login.card.login' | trans }}
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="block-content block-content-full bg-body-light text-center d-flex justify-content-between">
                                <a class="fs-sm fw-medium link-fx text-muted me-2 mb-1 d-inline-block" href="op_auth_signup3.html">
                                    <i class="fa fa-plus opacity-50 me-1"></i>
                                    {{ 'auth.login.card.register' | trans }}
                                </a>
                                <a class="fs-sm fw-medium link-fx text-muted me-2 mb-1 d-inline-block" href="op_auth_reminder3.html">
                                    {{ 'auth.login.card.forgot-password' | trans }}
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
